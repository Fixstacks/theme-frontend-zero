use Magento\Catalog\Helper\Output as OutputHelper;
use Magento\Catalog\Helper\Product\Compare;
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Wishlist\Helper\Data as WishlistHelper;
use Magento\Framework\Pricing\Render;

?>
<?php if ($exist = ($block->getRecentlyViewedProducts() && $block->getRecentlyViewedProducts()->getSize())): ?>
    <?php
    $type = 'widget-viewed-list';
    $image = 'recently_viewed_products_list_content_widget';
    $items = $block->getRecentlyViewedProducts();
    $outputHelper = $this->helper(OutputHelper::class);
    $wishlistHelper = $this->helper(WishlistHelper::class);
    $compareHelper = $this->helper(Compare::class);
    ?>
    <div class="block widget block-viewed-products">
        <div class="block-title title">
            <strong role="heading" aria-level="2"><?= $escaper->escapeHtml(__('Recently Viewed')) ?></strong>
        </div>
        <div class="block-content content">
            <div class="products wrapper list products-list">
                <ol class="products list items product-items">
                    <?php foreach ($items as $_item): ?>
                        <li class="item product product-item">
                            <div class="product-item-info">
                                <a href="<?= $escaper->escapeUrl($block->getProductUrl($_item)) ?>"
                                   class="product photo product-item-photo">
                                    <?= $block->getImage($_item, $image)->toHtml() ?>
                                </a>
                                <div class="product details product-item-details">
                                    <strong class="product name product-item-name">
                                        <a title="<?= $escaper->escapeHtmlAttr($_item->getName()) ?>"
                                           href="<?= $escaper->escapeUrl($block->getProductUrl($_item)) ?>"
                                           class="product-item-link">
                                            <?= $escaper->escapeHtml($_item->getName()) ?>
                                        </a>
                                    </strong>

                                    <?= $block->getProductPriceHtml(
                                        $_item,
                                        FinalPrice::PRICE_CODE,
                                        Render::ZONE_ITEM_LIST,
                                        ['price_id_suffix' => '-' . $type]
                                    ) ?>

                                    <?= $block->getReviewsSummaryHtml($_item, 'short') ?>

                                    <div class="product-item-description">
                                        <?= /* @noEscape */ $outputHelper->productAttribute(
                                            $_item,
                                            $_item->getShortDescription(),
                                            'short_description'
                                        ) ?>
                                        <a title="<?= $escaper->escapeHtmlAttr($_item->getName()) ?>"
                                           href="<?= $escaper->escapeUrl($block->getProductUrl($_item)) ?>"
                                           class="action more link link-primary text-sm no-underline hover:underline">
                                            <?= $escaper->escapeHtml(__('Learn More')) ?>
                                        </a>
                                    </div>

                                    <div class="product actions product-item-actions">
                                        <div class="actions-primary">
                                            <?php if ($_item->isSaleable()): ?>
                                                <?php if (!$_item->getTypeInstance()->isPossibleBuyFromList($_item)): ?>
                                                    <a class="action tocart primary btn btn-neutral hover:bg-primary hover:text-primary-content"
                                                       href="<?= $escaper->escapeUrl($block->getAddToCartUrl($_item)) ?>"
                                                       title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>">
                                                        <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                                    </a>
                                                <?php else: ?>
                                                    <form data-role="tocart-form"
                                                          data-product-sku="<?= $escaper->escapeHtmlAttr($_item->getSku()) ?>"
                                                          action="<?= $escaper->escapeUrl($block->getAddToCartUrl($_item)) ?>"
                                                          method="post">
                                                        <input type="hidden" name="product"
                                                               value="<?= (int) $_item->getEntityId() ?>">
                                                        <?= $block->getBlockHtml('formkey') ?>
                                                        <button type="submit"
                                                                title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>"
                                                                class="action tocart primary btn btn-neutral hover:bg-primary hover:text-primary-content">
                                                            <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                                        </button>
                                                    </form>
                                                <?php endif; ?>
                                            <?php elseif ($_item->isAvailable()): ?>
                                                <div class="stock available">
                                                    <span><?= $escaper->escapeHtml(__('In stock')) ?></span>
                                                </div>
                                            <?php else: ?>
                                                <div class="stock unavailable">
                                                    <span><?= $escaper->escapeHtml(__('Out of stock')) ?></span>
                                                </div>
                                            <?php endif; ?>
                                        </div>
                                        <div class="secondary-addto-links actions-secondary" data-role="add-to-links">
                                            <?php if ($wishlistHelper->isAllow()): ?>
                                                <form method="post"
                                                      action="<?= $escaper->escapeUrl($block->getUrl('wishlist/index/add')) ?>"
                                                      class="inline-block">
                                                    <?= $block->getBlockHtml('formkey') ?>
                                                    <input type="hidden" name="product"
                                                           value="<?= (int) $_item->getId() ?>" />
                                                    <button type="submit" class="action towishlist"
                                                            title="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                                                            aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>">
                                                        <span class="sr-only"><?= $escaper->escapeHtml(__('Add to Wish List')) ?></span>
                                                    </button>
                                                </form>
                                            <?php endif; ?>
                                            <?php if ($block->getAddToCompareUrl()): ?>
                                                <form method="post"
                                                      action="<?= $escaper->escapeUrl($compareHelper->getAddUrl()) ?>"
                                                      class="inline-block">
                                                    <?= $block->getBlockHtml('formkey') ?>
                                                    <input type="hidden" name="product"
                                                           value="<?= (int) $_item->getId() ?>" />
                                                    <button type="submit" class="action tocompare"
                                                            title="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>"
                                                            aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>">
                                                        <span class="sr-only"><?= $escaper->escapeHtml(__('Add to Compare')) ?></span>
                                                    </button>
                                                </form>
                                            <?php endif; ?>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    <?php endforeach ?>
                </ol>
            </div>
            <?= $block->getPagerHtml() ?>
        </div>
    </div>
<?php endif; ?>
