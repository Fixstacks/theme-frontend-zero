<?php if ($exist = ($block->getRecentlyViewedProducts() && $block->getRecentlyViewedProducts()->getSize())): ?>
    <div class="block widget block-viewed-products">
        <div class="block-title title">
            <strong role="heading" aria-level="2"><?= $escaper->escapeHtml(__('Recently Viewed')) ?></strong>
        </div>
        <div class="block-content content">
            <ol class="product-items product-items-images grid grid-cols-3 gap-2">
                <?php foreach ($block->getRecentlyViewedProducts() as $_product): ?>
                    <li class="product-item">
                        <a class="product-item-photo block" href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                           title="<?= $escaper->escapeHtmlAttr($_product->getName()) ?>">
                            <?= $block->getImage($_product, 'recently_viewed_products_images_only_widget')->toHtml() ?>
                        </a>
                    </li>
                <?php endforeach; ?>
            </ol>
            <?= $block->getPagerHtml() ?>
        </div>
    </div>
<?php endif; ?>
