 * Replaces stock's
 * Magento_Reports::widget/compared/column/compared_names_list.phtml
 * (names-only sidebar template). Same fix as `Magento_Reports::
 * widget/viewed/column/viewed_names_list.phtml`'s own docblock (the
 * "Recently Compared" sibling widget).
 *
 * @var \Magento\Reports\Block\Product\Compared $block
 * @var \Magento\Framework\Escaper $escaper
 */

use Magento\Catalog\Helper\Output as OutputHelper;

?>
<?php if ($exist = $block->getRecentlyComparedProducts()): ?>
    <?php $outputHelper = $this->helper(OutputHelper::class); ?>
    <div class="block widget block-compared-products">
        <div class="block-title title">
            <strong role="heading" aria-level="2"><?= $escaper->escapeHtml(__('Recently Compared')) ?></strong>
        </div>
        <div class="block-content content">
            <ol class="product-items product-items-names">
                <?php foreach ($exist as $_product): ?>
                    <li class="product-item">
                        <strong class="product-item-name">
                            <a href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                               title="<?= $escaper->escapeHtmlAttr($_product->getName()) ?>"
                               class="product-item-link">
                                <?= /* @noEscape */ $outputHelper->productAttribute($_product, $_product->getName(), 'name') ?>
                            </a>
                        </strong>
                    </li>
                <?php endforeach; ?>
            </ol>
            <?= $block->getPagerHtml() ?>
        </div>
    </div>
<?php endif; ?>
