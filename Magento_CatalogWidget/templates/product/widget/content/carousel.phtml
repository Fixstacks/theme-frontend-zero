 *
 * Carousel variant of the Catalog Products List widget: the
 * `.zero-product-slider-track` slider with full category-grid cards
 * (swatches, Add to Cart, Wishlist, Compare), reusing grid.phtml's markup.
 *
 * Uses ProductsList (not NewWidget) because getDetailsRendererList() loads
 * its own catalog_widget_product_list layout, which already has the Swatches
 * renderer; getProductDetailsHtml() renders the swatches (empty for simple
 * products) via the unchanged listing renderer.
 *
 * Without a `condition` argument the widget matches all enabled/visible
 * products, newest first.
 *
 * @var \Magento\CatalogWidget\Block\Product\ProductsList $block
 * @var \Magento\Framework\Escaper $escaper
 */

use Magento\Catalog\Block\Product\ReviewRendererInterface;
use Magento\Catalog\Helper\Product\Compare;
use Magento\Wishlist\Helper\Data as WishlistHelper;

?>
<?php if ($exist = ($block->getProductCollection() && $block->getProductCollection()->count())): ?>
    <?php
    $image = 'new_products_content_widget_grid';
    $items = $block->getProductCollection()->getItems();
    $templateType = ReviewRendererInterface::SHORT_VIEW;
    $wishlistHelper = $this->helper(WishlistHelper::class);
    $compareHelper = $this->helper(Compare::class);
    $uid = preg_replace('/[^a-zA-Z0-9_-]/', '-', (string) $block->getNameInLayout());
    ?>
    <div class="block widget block-products-list">
        <div class="flex items-center justify-between gap-4 mb-4">
            <?php if ($block->getTitle()): ?>
                <div class="block-title title">
                    <strong role="heading" aria-level="2" class="font-medium text-lg sm:text-xl">
                        <?= $escaper->escapeHtml(__($block->getTitle())) ?>
                    </strong>
                </div>
            <?php endif ?>
            <div class="flex items-center gap-2 ms-auto">
                <button type="button" id="<?= $escaper->escapeHtmlAttr($uid) ?>-prev" class="btn btn-circle btn-sm"
                        data-scroller-prev="#<?= $escaper->escapeHtmlAttr($uid) ?>-track"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Previous products')) ?>">&lsaquo;</button>
                <button type="button" id="<?= $escaper->escapeHtmlAttr($uid) ?>-next" class="btn btn-circle btn-sm"
                        data-scroller-next="#<?= $escaper->escapeHtmlAttr($uid) ?>-track"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Next products')) ?>">&rsaquo;</button>
            </div>
        </div>
        <div class="block-content content">
            <div id="<?= $escaper->escapeHtmlAttr($uid) ?>-track"
                 class="zero-product-slider-track flex gap-5 sm:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2">
                <?php foreach ($items as $_item): ?>
                    <div class="item product product-item shrink-0 snap-start w-[70%] sm:w-[45%] lg:w-1/4">
                        <div class="product-item-info">
                            <a href="<?= $escaper->escapeUrl($block->getProductUrl($_item)) ?>"
                               class="product photo product-item-photo">
                                <?= $block->getImage($_item, $image)->toHtml() ?>
                            </a>
                            <div class="product details product-item-details">
                                <strong class="product name product-item-name">
                                    <a title="<?= $escaper->escapeHtmlAttr($_item->getName()) ?>"
                                       href="<?= $escaper->escapeUrl($block->getProductUrl($_item)) ?>"
                                       class="product-item-link">
                                        <?= $escaper->escapeHtml($_item->getName()) ?>
                                    </a>
                                </strong>

                                <?= $block->getProductPriceHtml($_item) ?>

                                <?= $block->getReviewsSummaryHtml($_item, $templateType) ?>

                                <?= $block->getProductDetailsHtml($_item) ?>

                                <div class="product actions product-item-actions">
                                    <div class="actions-primary">
                                        <?php if ($_item->isSaleable()): ?>
                                            <?php if (!$_item->getTypeInstance()->isPossibleBuyFromList($_item)): ?>
                                                <a class="action tocart primary btn btn-neutral hover:bg-primary hover:text-primary-content"
                                                   href="<?= $escaper->escapeUrl($block->getAddToCartUrl($_item)) ?>"
                                                   title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>">
                                                    <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                                </a>
                                            <?php else: ?>
                                                <form data-role="tocart-form"
                                                      id="tocart-form-<?= (int) $_item->getId() ?>"
                                                      data-product-sku="<?= $escaper->escapeHtmlAttr($_item->getSku()) ?>"
                                                      action="<?= $escaper->escapeUrl($block->getAddToCartUrl($_item)) ?>"
                                                      method="post">
                                                    <input type="hidden" name="product"
                                                           value="<?= (int) $_item->getEntityId() ?>">
                                                    <?= $block->getBlockHtml('formkey') ?>
                                                    <button type="submit"
                                                            title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>"
                                                            class="action tocart primary btn btn-neutral hover:bg-primary hover:text-primary-content">
                                                        <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                                    </button>
                                                </form>
                                            <?php endif; ?>
                                        <?php elseif ($_item->isAvailable()): ?>
                                            <div class="stock available">
                                                <span><?= $escaper->escapeHtml(__('In stock')) ?></span>
                                            </div>
                                        <?php else: ?>
                                            <div class="stock unavailable">
                                                <span><?= $escaper->escapeHtml(__('Out of stock')) ?></span>
                                            </div>
                                        <?php endif; ?>
                                    </div>
                                    <div class="secondary-addto-links actions-secondary" data-role="add-to-links">
                                        <?php if ($wishlistHelper->isAllow()): ?>
                                            <form method="post"
                                                  action="<?= $escaper->escapeUrl($block->getUrl('wishlist/index/add')) ?>"
                                                  class="inline-block">
                                                <?= $block->getBlockHtml('formkey') ?>
                                                <input type="hidden" name="product"
                                                       value="<?= (int) $_item->getId() ?>" />
                                                <button type="submit" class="action towishlist"
                                                        title="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>">
                                                    <span class="sr-only"><?= $escaper->escapeHtml(__('Add to Wish List')) ?></span>
                                                </button>
                                            </form>
                                        <?php endif; ?>
                                        <?php if ($block->getAddToCompareUrl()): ?>
                                            <form method="post"
                                                  action="<?= $escaper->escapeUrl($compareHelper->getAddUrl()) ?>"
                                                  class="inline-block">
                                                <?= $block->getBlockHtml('formkey') ?>
                                                <input type="hidden" name="product"
                                                       value="<?= (int) $_item->getId() ?>" />
                                                <button type="submit" class="action tocompare"
                                                        title="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>"
                                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>">
                                                    <span class="sr-only"><?= $escaper->escapeHtml(__('Add to Compare')) ?></span>
                                                </button>
                                            </form>
                                        <?php endif; ?>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <?php endforeach ?>
            </div>
        </div>
    </div>
<?php endif; ?>
