 *
 * Custom options, stock markup. Stock's live price is the RequireJS
 * `priceOptions` widget (not loaded here); the script below adds chosen
 * options to the price box from getJsonConfig(). Display only: the cart
 * prices options on the server.
 *
 * @var \Magento\Catalog\Block\Product\View\Options $block
 * @var \Magento\Framework\Escaper $escaper
 */
$_options = $block->decorateArray($block->getOptions());
$_product = $block->getProduct();
?>
<?php if (count($_options)): ?>
    <?php foreach ($_options as $_option): ?>
        <?= $block->getOptionHtml($_option) ?>
    <?php endforeach; ?>
    <script type="application/json" id="zero-custom-options-config"><?= /* @noEscape */ '{"config":' . $block->getJsonConfig() . ',"productId":' . (int) $_product->getId() . ',"currency":' . json_encode($_product->getStore()->getCurrentCurrencyCode()) . '}' ?></script>
    <script src="<?= $escaper->escapeUrl($block->getViewFileUrl('js/product/custom-options.js')) ?>" defer></script>
<?php endif; ?>
