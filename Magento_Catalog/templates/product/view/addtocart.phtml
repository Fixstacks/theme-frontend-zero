 *
 * Product page Add to Cart.
 * - No `disabled` on the button (stock's JS removed it); cart/add validates.
 * - Qty −/+ call stepUp()/stepDown() via data-qty-step (web/js/zero.js).
 * - Wishlist/compare icons are looked up with getBlock(), not <move>: two
 *   block instances use this template and a move reaches one. The originals
 *   are hidden with CSS, not removed (removing deletes what the lookup needs).
 *
 * @var $block \Magento\Catalog\Block\Product\View
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<?php $_product = $block->getProduct(); ?>
<?php $buttonTitle = __('Add to Cart'); ?>
<?php $wishlistBlock = $block->getLayout()->getBlock('view.addto.wishlist'); ?>
<?php $compareBlock = $block->getLayout()->getBlock('view.addto.compare'); ?>
<?php if ($_product->isSaleable()):?>
<div class="box-tocart">
    <div class="fieldset">
        <div class="actions flex flex-wrap items-center gap-3">
            <?php if ($block->shouldRenderQuantity()):?>
            <div class="field qty flex-none h-10">
                <label class="label sr-only" for="qty"><span><?= $escaper->escapeHtml(__('Qty')) ?></span></label>
                <div class="control qty-stepper flex items-stretch h-full border border-base-300 overflow-hidden">
                    <button type="button"
                            class="qty-stepper-btn flex items-center justify-center w-9 shrink-0 bg-transparent border-0 text-lg leading-none text-base-content cursor-pointer hover:bg-base-200"
                            data-qty-step="down"
                            aria-label="<?= $escaper->escapeHtmlAttr(__('Decrease quantity')) ?>">&minus;</button>
                    <input type="number"
                           name="qty"
                           id="qty"
                           min="0"
                           value="<?= $block->getProductDefaultQty() * 1 ?>"
                           title="<?= $escaper->escapeHtmlAttr(__('Qty')) ?>"
                           class="input-text qty w-12 border-0 border-x border-base-300 rounded-none text-center py-2"
                           data-validate="<?= $escaper->escapeHtml(json_encode($block->getQuantityValidators())) ?>"
                           />
                    <button type="button"
                            class="qty-stepper-btn flex items-center justify-center w-9 shrink-0 bg-transparent border-0 text-lg leading-none text-base-content cursor-pointer hover:bg-base-200"
                            data-qty-step="up"
                            aria-label="<?= $escaper->escapeHtmlAttr(__('Increase quantity')) ?>">+</button>
                </div>
            </div>
            <?php endif; ?>
            <button type="submit"
                    title="<?= $escaper->escapeHtmlAttr($buttonTitle) ?>"
                    class="action primary tocart btn btn-neutral hover:bg-primary hover:text-primary-content flex-auto"
                    id="product-addtocart-button">
                <span><?= $escaper->escapeHtml($buttonTitle) ?></span>
            </button>
            <?php if ($wishlistBlock || $compareBlock): ?>
                <div class="box-tocart-icon-actions flex flex-none gap-3">
                    <?php if ($wishlistBlock): ?>
                        <?= /* @noEscape */ $wishlistBlock->toHtml() ?>
                    <?php endif; ?>
                    <?php if ($compareBlock): ?>
                        <?= /* @noEscape */ $compareBlock->toHtml() ?>
                    <?php endif; ?>
                </div>
            <?php endif; ?>
            <?= $block->getChildHtml('', true) ?>
        </div>
    </div>
</div>
<?php endif; ?>
