 *
 * Product page "Add to Compare" (icon only), also rendered by
 * addtocart.phtml inside #product_addtocart_form. Not a <form>: a nested
 * form's form_key leaked into Add to Cart's POST. It uses
 * form="product_addtocart_form" + formaction, like the wishlist button.
 *
 * @var \Magento\Catalog\Block\Product\View\Addto\Compare $block
 * @var \Magento\Framework\Escaper $escaper
 */
$viewModel = $block->getData('addToCompareViewModel');
$compareHelper = $this->helper(\Magento\Catalog\Helper\Product\Compare::class);
?>

<?php if ($viewModel->isAvailableForCompare($block->getProduct())) :?>
<button type="submit"
        form="product_addtocart_form"
        formaction="<?= $escaper->escapeUrl($compareHelper->getAddUrl()) ?>"
        data-role="add-to-links"
        class="action tocompare"
        aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>">
    <span class="sr-only"><?= $escaper->escapeHtml(__('Add to Compare')) ?></span>
</button>
<?php endif; ?>
