 *
 * Product grid/list (category, search, widgets). No `disabled` on Add to Cart
 * (stock relies on catalogAddToCart JS to enable it) and no catalogAddToCart
 * init: the form is a plain POST; messages and the cart counter refresh via
 * the Zero_Core fragments. Each photo carries the product's "New" / "Sale"
 * badges (Zero_Core's zero.product.badges block, absent under other themes).
 * With Zero_Core's `card_cache` argument each card comes from the block cache
 * (ViewModel\ProductCardCache); Add to Cart's URL carries the current page, so
 * it goes in as placeholders after the card is rendered or loaded.
 *
 * @var $block \Magento\Catalog\Block\Product\ListProduct
 * @var \Magento\Framework\Escaper $escaper
 */
use Magento\Framework\App\Action\Action;

?>
<?php
$_productCollection = $block->getLoadedProductCollection();
/** @var \Magento\Catalog\Helper\Output $_helper */
$_helper = $block->getData('outputHelper');
?>
<?php if ($block->getData('has_error') || !$_productCollection->count()): ?>
    <div class="message info empty alert alert-info alert-soft text-sm py-2">
        <div><?= $escaper->escapeHtml(__('We can\'t find products matching the selection.')) ?></div>
    </div>
<?php else: ?>
    <?= $block->getToolbarHtml() ?>
    <?= $block->getAdditionalHtml() ?>
    <?php
    if ($block->getMode() === 'grid') {
        $viewMode = 'grid';
        $imageDisplayArea = 'category_page_grid';
        $showDescription = false;
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::SHORT_VIEW;
    } else {
        $viewMode = 'list';
        $imageDisplayArea = 'category_page_list';
        $showDescription = true;
        $templateType = \Magento\Catalog\Block\Product\ReviewRendererInterface::FULL_VIEW;
    }
    /**
     * Position for actions regarding image size changing in vde if needed
     */
    $pos = $block->getPositioned();
    ?>
    <?php
    $badgesBlock = $block->getLayout()->getBlock('zero.product.badges');
    // Zero_QuickView's button, when the module is there (rendered per card, as the badges).
    $quickViewBlock = $block->getLayout()->getBlock('zero.quickview.button');
    /** @var \Zero\Core\ViewModel\ProductCardCache|null $cardCache */
    $cardCache = $block->getData('card_cache');
    $renderCard = function ($_product) use (
        $block,
        $escaper,
        $_helper,
        $viewMode,
        $imageDisplayArea,
        $showDescription,
        $templateType,
        $pos,
        $badgesBlock,
        $quickViewBlock
    ): string {
        ob_start();
        ?>
            <li class="item product product-item">
                <div class="product-item-info"
                     id="product-item-info_<?= /* @noEscape */ $_product->getId() ?>"
                     data-container="product-<?= /* @noEscape */ $viewMode ?>">
                    <?php
                    $productImage = $block->getImage($_product, $imageDisplayArea);
                    if ($pos != null) {
                        $position = 'left:' . $productImage->getWidth() . 'px;'
                            . 'top:' . $productImage->getHeight() . 'px;';
                    }
                    ?>
                    <?php // Product Image, with the Quick View button over its bottom edge (badges at the top) ?>
                    <div class="product-item-media relative">
                        <a href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                           class="product photo product-item-photo"
                           tabindex="-1">
                            <?= $productImage->toHtml() ?>
                            <?= $badgesBlock ? $badgesBlock->setProduct($_product)->toHtml() : '' ?>
                        </a>
                        <?= $quickViewBlock ? $quickViewBlock->setProduct($_product)->toHtml() : '' ?>
                    </div>
                    <div class="product details product-item-details">
                        <?php $_productNameStripped = $block->stripTags($_product->getName(), null, true); ?>
                        <strong class="product name product-item-name">
                            <a class="product-item-link"
                               href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>">
                                <?=/* @noEscape */ $_helper->productAttribute($_product, $_product->getName(), 'name')?>
                            </a>
                        </strong>
                        <?= $block->getReviewsSummaryHtml($_product, $templateType) ?>
                        <?= /* @noEscape */ $block->getProductPrice($_product) ?>

                        <?= $block->getProductDetailsHtml($_product) ?>

                        <div class="product-item-inner">
                            <div class="product actions product-item-actions"<?= ($pos && strpos($pos, $viewMode . '-actions')) ? ' style="' . $escaper->escapeHtmlAttr($position) . '"' : '' ?>>
                                <div class="actions-primary"<?= ($pos && strpos($pos, $viewMode . '-primary')) ? ' style="' . $escaper->escapeHtmlAttr($position) . '"' : '' ?>>
                                    <?php if ($_product->isSaleable()):?>
                                        <?php /*
                                         * The form id lets the card's swatch radios (rendered earlier by
                                         * Magento_Swatches::product/listing/renderer.phtml) join this form via
                                         * form="...".
                                         */ ?>
                                        <form data-role="tocart-form"
                                              id="tocart-form-<?= (int) $_product->getId() ?>"
                                              data-product-sku="<?= $escaper->escapeHtml($_product->getSku()) ?>"
                                              action="%%zero-tocart-action%%"
                                              method="post">
                                            <?php $options = $block->getData('viewModel')->getOptionsData($_product); ?>
                                            <?php foreach ($options as $optionItem): ?>
                                                <input type="hidden"
                                                       name="<?= $escaper->escapeHtml($optionItem['name']) ?>"
                                                       value="<?= $escaper->escapeHtml($optionItem['value']) ?>">
                                            <?php endforeach; ?>
                                            <input type="hidden"
                                                   name="product"
                                                   value="<?= (int) $_product->getId() ?>">
                                            <input type="hidden"
                                                   name="<?= /* @noEscape */ Action::PARAM_NAME_URL_ENCODED ?>"
                                                   value="%%zero-tocart-uenc%%">
                                            <?= $block->getBlockHtml('formkey') ?>
                                            <button type="submit"
                                                    title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>"
                                                    class="action tocart primary btn btn-neutral hover:bg-primary hover:text-primary-content">
                                                <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                                            </button>
                                        </form>
                                    <?php else:?>
                                        <?php if ($_product->isAvailable()):?>
                                            <div class="stock available">
                                                <span><?= $escaper->escapeHtml(__('In stock')) ?></span></div>
                                        <?php else:?>
                                            <div class="stock unavailable">
                                                <span><?= $escaper->escapeHtml(__('Out of stock')) ?></span></div>
                                        <?php endif; ?>
                                    <?php endif; ?>
                                </div>
                                <div data-role="add-to-links" class="actions-secondary"<?= ($pos && strpos($pos, $viewMode . '-secondary')) ? ' style="' . $escaper->escapeHtmlAttr($position) . '"' : '' ?>>
                                    <?php if ($addToBlock = $block->getChildBlock('addto')): ?>
                                        <?= $addToBlock->setProduct($_product)->getChildHtml() ?>
                                    <?php endif; ?>
                                </div>
                            </div>
                            <?php if ($showDescription): ?>
                                <div class="product description product-item-description">
                                    <?= /* @noEscape */ $_helper->productAttribute(
                                        $_product,
                                        $_product->getShortDescription(),
                                        'short_description'
                                    ) ?>
                                    <a href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                                       title="<?= /* @noEscape */ $_productNameStripped ?>"
                                       class="action more link link-neutral text-sm no-underline hover:underline"><?= $escaper->escapeHtml(__('Learn More')) ?></a>
                                </div>
                            <?php endif; ?>
                        </div>
                    </div>
                </div>
            </li>
        <?php
        return (string) ob_get_clean();
    };
    ?>
    <div class="products wrapper <?= /* @noEscape */ $viewMode ?> products-<?= /* @noEscape */ $viewMode ?>">
        <ol class="products list items product-items">
            <?php /** @var $_product \Magento\Catalog\Model\Product */ ?>
            <?php foreach ($_productCollection as $_product): ?>
                <?php
                $postParams = $block->getAddToCartPostParams($_product);
                $replace = [
                    '%%zero-tocart-action%%' => $escaper->escapeUrl($postParams['action']),
                    '%%zero-tocart-uenc%%' => $escaper->escapeHtmlAttr($postParams['data'][Action::PARAM_NAME_URL_ENCODED]),
                ];
                ?>
                <?= /* @noEscape */ $cardCache
                    ? $cardCache->render(
                        $_product,
                        $block,
                        [$viewMode, $imageDisplayArea, $showDescription, $templateType, (string) $pos],
                        fn () => $renderCard($_product),
                        $replace
                    )
                    : strtr($renderCard($_product), $replace) ?>
            <?php endforeach; ?>
            <?php // getBlock() gives false, not null, when a module's block is missing.
            if ($badgesBlock) {
                $badgesBlock->unsetData('product');
            }
            if ($quickViewBlock) {
                $quickViewBlock->unsetData('product');
            } ?>
        </ol>
    </div>
    <?= $block->getChildBlock('toolbar')->setIsBottom(true)->toHtml() ?>
    <?php // phpcs:ignore Magento2.Legacy.PhtmlTemplate ?>
<?php endif; ?>
