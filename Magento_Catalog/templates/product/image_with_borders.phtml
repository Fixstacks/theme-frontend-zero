 *
 * Product card image: stock's, plus a <picture> with WebP and 300/600 px
 * copies (ProductPicture, as `zero_picture`) for sharp high-density screens;
 * without them, stock's plain <img>.
 *
 * @var \Magento\Catalog\Block\Product\Image $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
$width = (int) $block->getWidth();
$height = (int) $block->getHeight();
$paddingBottom = $block->getRatio() * 100;
/** @var \Zero\Core\Model\Image\ProductPicture|null $picture */
$picture = $block->getData('zero_picture');
$srcsets = $picture ? $picture->getSrcsets((string) $block->getImageUrl(), $width, $height, \Zero\Core\Model\Image\ProductPicture::CARD_WIDTHS) : null;
// Cards: 2 per row on phones, 3 on tablets, about 300 px wide from desktop up.
$sizes = '(min-width: 1024px) 300px, (min-width: 640px) 33vw, 50vw';
?>
<span class="product-image-container product-image-container-<?= /* @noEscape */ $block->getProductId() ?>">
    <span class="product-image-wrapper">
        <?php if ($srcsets): ?><picture>
            <source type="image/webp"
                    srcset="<?= $escaper->escapeHtml($srcsets['webp']) ?>"
                    sizes="<?= /* @noEscape */ $sizes ?>"><?php endif; ?>
        <img class="<?= $escaper->escapeHtmlAttr($block->getClass()) ?>"
            <?php foreach ($block->getCustomAttributes() as $name => $value): ?>
                <?= $escaper->escapeHtmlAttr($name) ?>="<?= $escaper->escapeHtml($value) ?>"
            <?php endforeach; ?>
            src="<?= $escaper->escapeUrl($block->getImageUrl()) ?>"
            <?php if ($srcsets): ?>
            srcset="<?= $escaper->escapeHtml($srcsets['jpeg']) ?>"
            sizes="<?= /* @noEscape */ $sizes ?>"
            <?php endif; ?>
            loading="lazy"
            width="<?= $escaper->escapeHtmlAttr($block->getWidth()) ?>"
            height="<?= $escaper->escapeHtmlAttr($block->getHeight()) ?>"
            alt="<?= $escaper->escapeHtmlAttr($block->getLabel()) ?>"/><?php if ($srcsets): ?></picture><?php endif; ?></span>
</span>
<?php
$styles = <<<STYLE
.product-image-container-{$block->getProductId()} {
    width: {$width}px;
    height: auto;
    aspect-ratio: {$width} / {$height};
}
.product-image-container-{$block->getProductId()} span.product-image-wrapper {
    height: 100%;
    width: 100%;
}
@supports not (aspect-ratio: auto) {
    .product-image-container-{$block->getProductId()} span.product-image-wrapper {
        padding-bottom: {$paddingBottom}%;
    }
}
STYLE;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('style', [], $styles, false) ?>
