 *
 * "New Products" widget, names-only sidebar list; reuses the compare
 * sidebar's `.product-items-names` style.
 *
 * @var \Magento\Catalog\Block\Product\Widget\NewWidget $block
 * @var \Magento\Framework\Escaper $escaper
 */

use Magento\Catalog\Helper\Output as OutputHelper;

?>
<?php if (($_products = $block->getProductCollection()) && $_products->getSize()): ?>
    <?php $outputHelper = $this->helper(OutputHelper::class); ?>
    <div class="block widget block-new-products">
        <div class="block-title title">
            <strong role="heading" aria-level="2"><?= $escaper->escapeHtml(__('New Products')) ?></strong>
        </div>
        <div class="block-content content">
            <ol class="product-items product-items-names">
                <?php foreach ($_products->getItems() as $_product): ?>
                    <li class="product-item">
                        <strong class="product-item-name">
                            <a href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                               title="<?= $escaper->escapeHtmlAttr($_product->getName()) ?>"
                               class="product-item-link">
                                <?= /* @noEscape */ $outputHelper->productAttribute($_product, $_product->getName(), 'name') ?>
                            </a>
                        </strong>
                    </li>
                <?php endforeach; ?>
            </ol>
            <?= $block->getPagerHtml() ?>
        </div>
    </div>
<?php endif; ?>
