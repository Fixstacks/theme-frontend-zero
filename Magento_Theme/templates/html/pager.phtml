 *
 * Shared pager (also the catalog toolbar's). Page links are plain <a href>
 * that also hx-get/hx-select/hx-swap #page-columns. The "Show N" limiter is a
 * link list instead of stock's redirectUrl-driven <select>.
 *
 * @var \Magento\Theme\Block\Html\Pager $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\Locale\LocaleFormatter $localeFormatter
 */
?>
<?php if ($block->getCollection()->getSize()): ?>

    <?php if ($block->getUseContainer()): ?>
    <div class="pager flex flex-wrap items-center justify-between gap-3">
    <?php endif ?>

        <?php if ($block->getShowAmounts()): ?>
        <p class="toolbar-amount text-sm text-base-content/60">
            <span class="toolbar-number font-medium text-base-content">
            <?php if ($block->getLastPageNum()>1): ?>
                <?= $block->escapeHtml(
                    __(
                        'Items %1 to %2 of %3 total',
                        $localeFormatter->formatNumber($block->getFirstNum()),
                        $localeFormatter->formatNumber($block->getLastNum()),
                        $localeFormatter->formatNumber($block->getTotalNum())
                    )
                ) ?>
            <?php elseif ($block->getTotalNum() == 1): ?>
                <?= $block->escapeHtml(__('%1 Item', $localeFormatter->formatNumber($block->getTotalNum()))) ?>
            <?php else: ?>
                <?= $block->escapeHtml(__('%1 Item(s)', $localeFormatter->formatNumber($block->getTotalNum()))) ?>
            <?php endif; ?>
            </span>
        </p>
        <?php endif ?>

        <?php if ($block->getLastPageNum()>1): ?>
        <div class="pages">
            <strong class="label pages-label sr-only" id="paging-label"><?= $block->escapeHtml(__('Page')) ?></strong>
            <ul class="items pages-items join" aria-labelledby="paging-label">
            <?php if (!$block->isFirstPage()): ?>
                <li class="item pages-item-previous">
                    <?php $text = $block->getAnchorTextForPrevious() ? $block->getAnchorTextForPrevious() : '';?>
                    <a class="<?= $block->escapeHtmlAttr($text ? 'link ' : 'action ') ?> previous btn btn-sm join-item"
                       href="<?= $block->escapeUrl($block->getPreviousPageUrl()) ?>"
                       hx-get="<?= $block->escapeUrl($block->getPreviousPageUrl()) ?>"
                       hx-target="#page-columns" hx-select="#page-columns"
                       hx-swap="outerHTML" hx-push-url="true"
                       title="<?= $block->escapeHtmlAttr($text ? $text : __('Previous')) ?>">
                        <span class="label sr-only"><?= $block->escapeHtml(__('Page')) ?></span>
                        <span aria-hidden="true">&lsaquo;</span>
                        <span class="sr-only"><?= $block->escapeHtml($text ? $text : __('Previous')) ?></span>
                    </a>
                </li>
            <?php endif;?>

            <?php if ($block->canShowFirst()): ?>
                <li class="item">
                    <a class="page first btn btn-sm join-item" href="<?= $block->escapeUrl($block->getFirstPageUrl()) ?>"
                       hx-get="<?= $block->escapeUrl($block->getFirstPageUrl()) ?>"
                       hx-target="#page-columns" hx-select="#page-columns"
                       hx-swap="outerHTML" hx-push-url="true">
                        <span class="label sr-only"><?= $block->escapeHtml(__('Page')) ?></span>
                        <span><?= $block->escapeHtml($localeFormatter->formatNumber(1)) ?></span>
                    </a>
                </li>
            <?php endif;?>

            <?php if ($block->canShowPreviousJump()): ?>
                <li class="item">
                    <a class="page previous jump btn btn-sm join-item btn-ghost"
                       title=""
                       aria-label="<?= $escaper->escapeHtmlAttr(__(
                           'Skip to page %1',
                           $localeFormatter->formatNumber($block->getPreviousJumpPage())
                       )) ?>"
                       href="<?= $block->escapeUrl($block->getPreviousJumpUrl()) ?>"
                       hx-get="<?= $block->escapeUrl($block->getPreviousJumpUrl()) ?>"
                       hx-target="#page-columns" hx-select="#page-columns"
                       hx-swap="outerHTML" hx-push-url="true">
                        <span>&hellip;</span>
                    </a>
                </li>
            <?php endif;?>

            <?php foreach ($block->getFramePages() as $_page): ?>
                <?php if ($block->isPageCurrent($_page)): ?>
                    <li class="item current">
                        <strong class="page btn btn-sm join-item btn-primary no-animation">
                            <span class="label sr-only"><?= $block->escapeHtml(__('You\'re currently reading page')) ?></span>
                            <span><?= $block->escapeHtml($localeFormatter->formatNumber($_page)) ?></span>
                        </strong>
                    </li>
                <?php else: ?>
                    <li class="item">
                        <a href="<?= $block->escapeUrl($block->getPageUrl($_page)) ?>" class="page btn btn-sm join-item btn-ghost"
                           hx-get="<?= $block->escapeUrl($block->getPageUrl($_page)) ?>"
                           hx-target="#page-columns" hx-select="#page-columns"
                           hx-swap="outerHTML" hx-push-url="true">
                            <span class="label sr-only"><?= $block->escapeHtml(__('Page')) ?></span>
                            <span><?= $block->escapeHtml($localeFormatter->formatNumber($_page)) ?></span>
                        </a>
                    </li>
                <?php endif;?>
            <?php endforeach;?>

            <?php if ($block->canShowNextJump()): ?>
                <li class="item">
                    <a class="page next jump btn btn-sm join-item btn-ghost"
                       title=""
                       aria-label="<?= $escaper->escapeHtmlAttr(__(
                           'Skip to page %1',
                           $localeFormatter->formatNumber($block->getNextJumpPage())
                       )) ?>"
                       href="<?= $block->escapeUrl($block->getNextJumpUrl()) ?>"
                       hx-get="<?= $block->escapeUrl($block->getNextJumpUrl()) ?>"
                       hx-target="#page-columns" hx-select="#page-columns"
                       hx-swap="outerHTML" hx-push-url="true">
                        <span>&hellip;</span>
                    </a>
                </li>
            <?php endif;?>

            <?php if ($block->canShowLast()): ?>
              <li class="item">
                  <a class="page last btn btn-sm join-item" href="<?= $block->escapeUrl($block->getLastPageUrl()) ?>"
                     hx-get="<?= $block->escapeUrl($block->getLastPageUrl()) ?>"
                     hx-target="#page-columns" hx-select="#page-columns"
                     hx-swap="outerHTML" hx-push-url="true">
                      <span class="label sr-only"><?= $block->escapeHtml(__('Page')) ?></span>
                      <span><?= $block->escapeHtml($localeFormatter->formatNumber($block->getLastPageNum())) ?></span>
                  </a>
              </li>
            <?php endif;?>

            <?php if (!$block->isLastPage()): ?>
                <li class="item pages-item-next">
                    <?php $text = $block->getAnchorTextForNext() ? $block->getAnchorTextForNext() : '';?>
                    <a class="<?= /* @noEscape */ $text ? 'link ' : 'action ' ?> next btn btn-sm join-item"
                       href="<?= $block->escapeUrl($block->getNextPageUrl()) ?>"
                       hx-get="<?= $block->escapeUrl($block->getNextPageUrl()) ?>"
                       hx-target="#page-columns" hx-select="#page-columns"
                       hx-swap="outerHTML" hx-push-url="true"
                       title="<?= $block->escapeHtmlAttr($text ? $text : __('Next')) ?>">
                        <span class="label sr-only"><?= $block->escapeHtml(__('Page')) ?></span>
                        <span aria-hidden="true">&rsaquo;</span>
                        <span class="sr-only"><?= $block->escapeHtml($text ? $text : __('Next')) ?></span>
                    </a>
                </li>
            <?php endif;?>
            </ul>
        </div>
        <?php endif; ?>

    <?php if ($block->isShowPerPage()): ?>
        <div class="limiter flex items-center gap-2">
            <strong class="limiter-label text-sm text-base-content/60 font-normal" id="limiter-label"><?= $block->escapeHtml(__('Show')) ?></strong>
            <div class="join">
                <?php foreach ($block->getAvailableLimit() as $_key => $_limit): ?>
                    <?php $limitUrl = $block->getLimitUrl($_key); ?>
                    <?php if ($block->isLimitCurrent($_key)): ?>
                        <span class="limiter-current btn btn-xs join-item btn-primary no-animation">
                            <?= $block->escapeHtml($localeFormatter->formatNumber((int) $_limit)) ?>
                        </span>
                    <?php else: ?>
                        <a href="<?= $block->escapeUrl($limitUrl) ?>"
                           hx-get="<?= $block->escapeUrl($limitUrl) ?>"
                           hx-target="#page-columns" hx-select="#page-columns"
                           hx-swap="outerHTML" hx-push-url="true"
                           class="btn btn-xs join-item btn-ghost">
                            <?= $block->escapeHtml($localeFormatter->formatNumber((int) $_limit)) ?>
                        </a>
                    <?php endif; ?>
                <?php endforeach; ?>
            </div>
            <span class="limiter-text text-sm text-base-content/60"><?= $block->escapeHtml(__('per page')) ?></span>
        </div>
    <?php endif ?>

    <?php if ($block->getUseContainer()): ?>
    </div>
    <?php endif ?>

<?php endif ?>
