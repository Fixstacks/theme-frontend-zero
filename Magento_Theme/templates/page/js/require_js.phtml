 *
 * RequireJS base URL (the root template prints the `require.js` block):
 * only on the stock checkout, the one page with RequireJS and never cached
 * (its nonce wouldn't survive the page cache).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 * @var \Magento\Framework\Locale\LocaleFormatter $localeFormatter
 */
if ($block->getRequest()->getFullActionName() !== 'checkout_index_index') {
    return;
}
$scriptString = '
    var LOCALE = \'' . /* @noEscape */ $block->escapeJs($localeFormatter->getLocaleJs()) . '\';
    var BASE_URL = \'' . /* @noEscape */ $block->escapeJs($block->getBaseUrl()) . '\';
    var require = {
        \'baseUrl\': \'' . /* @noEscape */ $block->escapeJs($block->getViewFileUrl('/')) . '\'
    };';

echo /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false);
