<?xml version="1.0"?>
<!--
    Head assets: stock's legacy CSS and the RequireJS loader out (removed
    names can never return; the stock checkout re-adds them renamed), the
    Tailwind CSS, htmx.min.js and js/zero.js in.
    - app.css stays render-blocking: a preload swap measured CLS = 1.
    - htmx allowEval:false: the strict CSP forbids eval.
    - requirejs-config is removed as a block: on checkout success its insert
      worked and require.config() threw on every order.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="mage/calendar.css"/>
        <remove src="requirejs/require.js"/>
        <remove src="css/styles-m.css"/>
        <remove src="css/styles-l.css"/>
        <remove src="css/print.css"/>
        <remove src="jquery/uppy/dist/uppy-custom.css"/>
        <css src="css/app.css"/>
        <!-- The self-hosted fonts, downloading alongside the CSS that uses them. A child theme
             with other fonts removes them (<remove src="…"/>): they compete with the LCP image. -->
        <link src="fonts/dm-sans-latin-400-700.woff2" rel="preload" as="font" type="font/woff2" crossorigin="anonymous"/>
        <link src="fonts/instrument-serif-italic-400.woff2" rel="preload" as="font" type="font/woff2" crossorigin="anonymous"/>
        <script src="js/htmx.min.js"/>
        <script src="js/zero.js" defer="defer"/>
        <meta name="htmx-config" content="{&quot;allowEval&quot;:false}"/>
        <meta name="format-detection" content="telephone=no"/>
    </head>
    <body>
        <referenceBlock name="requirejs-config" remove="true"/>
    </body>
</page>
