 *
 * "Allow remote shopping assistance": stock's real field was an empty hidden
 * input only its JS filled. Here a hidden `assistance_allowed=DENIED` comes
 * before the checkbox with ALLOWED (PHP keeps the last value). No `toggle`
 * class: DaisyUI draws it as a switch.
 *
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\LoginAsCustomerAssistance\ViewModel\ShoppingAssistanceViewModel $viewModel
 */
use Magento\LoginAsCustomerAssistance\Api\IsAssistanceEnabledInterface;

$viewModel = $block->getViewModel();
?>
<?php if ($viewModel->isLoginAsCustomerEnabled()) : ?>
    <div class="field choice">
        <input type="hidden" name="assistance_allowed"
               value="<?= /* @noEscape */ IsAssistanceEnabledInterface::DENIED ?>">
        <input type="checkbox"
               name="assistance_allowed"
               title="<?= $escaper->escapeHtmlAttr(__($viewModel->getAssistanceCheckboxTitle())) ?>"
               value="<?= /* @noEscape */ IsAssistanceEnabledInterface::ALLOWED ?>"
               id="assistance_allowed_checkbox"
                <?php if ($viewModel->isAssistanceAllowed()) : ?>checked="checked"<?php endif; ?>
               class="checkbox">
        <label for="assistance_allowed_checkbox" class="label">
            <span><?= $escaper->escapeHtmlAttr(__($viewModel->getAssistanceCheckboxTitle())) ?></span>
        </label>

        <div class="field-tooltip">
            <span id="tooltip-label" class="label"><span><?= $escaper->escapeHtml(__('Tooltip')) ?></span></span>
            <span id="tooltip" class="field-tooltip-action action-help" tabindex="0"
                  aria-labelledby="tooltip-label" aria-haspopup="true" aria-expanded="false" role="button">
         </span>
            <div class="field-tooltip-content" data-target="dropdown"
                 aria-hidden="true">
                <?= $escaper->escapeHtmlAttr(__($viewModel->getAssistanceCheckboxTooltip())) ?>
            </div>
        </div>
    </div>
<?php endif ?>
