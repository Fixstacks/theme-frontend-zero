 *
 * Cart totals, server-rendered (stock's is a Knockout placeholder).
 * getTotals() has no grand total, so it's built here and rendered with
 * `area => -1`, which total/default.phtml bolds.
 *
 * @var \Magento\Checkout\Block\Cart\Totals $block
 */
$grandTotal = new \Magento\Framework\DataObject([
    'code' => 'grand_total',
    'area' => -1,
    'value' => $block->getQuote()->getGrandTotal(),
    'title' => __('Order Total'),
]);
?>
<div id="cart-totals" class="cart-totals">
    <table class="data table table-totals">
        <caption class="table-caption"><?= $block->escapeHtml(__('Order Total')) ?></caption>
        <tbody>
            <?= /* @noEscape */ $block->renderTotals() ?>
            <?= /* @noEscape */ $block->renderTotal($grandTotal) ?>
        </tbody>
    </table>
</div>
