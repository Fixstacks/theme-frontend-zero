<div id="block-shipping" class="block shipping">
    <div class="title" data-role="title">
        <strong id="block-shipping-heading" role="heading" aria-level="2">
            <?= $block->getQuote()->isVirtual()
                ? $escaper->escapeHtml(__('Tax'))
                : $escaper->escapeHtml(__('Shipping and Tax'))
            ?>
        </strong>
    </div>
    <div class="content" aria-labelledby="block-shipping-heading">
        <p class="text-sm text-base-content/70">
            <?= $block->getQuote()->isVirtual()
                ? $escaper->escapeHtml(__('Tax is calculated at checkout, based on your address.'))
                : $escaper->escapeHtml(__('Shipping and tax are calculated at checkout, based on your address.'))
            ?>
        </p>
    </div>
</div>
