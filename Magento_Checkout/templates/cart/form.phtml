 *
 * Cart items form: Update is a plain submit to updatePost (the AJAX widgets
 * are dropped); Clear (when enable_clear_shopping_cart is on) submits
 * update_cart_action=empty_cart.
 *
 * @var $block \Magento\Checkout\Block\Cart\Grid
 * @var \Magento\Framework\Escaper $escaper
