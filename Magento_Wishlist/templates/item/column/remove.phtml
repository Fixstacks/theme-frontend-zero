 *
 * Wish list item "Remove" with formaction, like item/column/cart.phtml;
 * Index\Remove reads only `item`, so posting the whole form is safe.
 *
 * @var \Magento\Wishlist\Block\Customer\Wishlist\Item\Column\Remove $block
 * @var \Magento\Framework\Escaper $escaper
 */
$item = $block->getItem();
?>
<button type="submit"
        formaction="<?= $escaper->escapeUrl($block->getUrl('wishlist/index/remove')) ?>"
        name="item" value="<?= $escaper->escapeHtmlAttr($item->getId()) ?>"
        title="<?= $escaper->escapeHtmlAttr(__('Remove Item')) ?>"
        class="btn-remove action delete link link-error text-sm no-underline hover:underline">
    <span><?= $escaper->escapeHtml(__('Remove item')) ?></span>
</button>
