 *
 * "Update Wish List" on the item configure page (stock used data-post JS):
 * the button and hidden `id` use form="product_addtocart_form" +
 * formaction, so the product's options post with them.
 *
 * @var \Magento\Wishlist\Block\Item\Configure $block
 * @var \Magento\Framework\Escaper $escaper
 */
// getWishlistItem() (the real source of this item's own id) is a PROTECTED method on this
// block, unreachable directly from the template — so the real id is read back out of
// getUpdateParams()'s own already-computed JSON instead (`{"action":..,"data":{"id":..,
// "product":..,"qty":..}}`, built by Wishlist\Helper\Data::getUpdateParams() from that exact
// same protected value), rather than re-deriving it a second, riskier way.
$updateParams = json_decode((string) $block->getUpdateParams(), true);
$wishlistItemId = $updateParams['data']['id'] ?? null;
?>
<?php if ($wishlistItemId && $this->helper(\Magento\Wishlist\Helper\Data::class)->isAllow()) : ?>
    <input type="hidden" name="id" value="<?= (int) $wishlistItemId ?>" form="product_addtocart_form">
    <button type="submit"
            form="product_addtocart_form"
            formaction="<?= $block->escapeUrl($block->getUrl('wishlist/index/updateItemOptions')) ?>"
            formmethod="post"
            class="action towishlist updated">
        <span><?= $block->escapeHtml(__('Update Wish List')) ?></span>
    </button>
<?php endif; ?>
