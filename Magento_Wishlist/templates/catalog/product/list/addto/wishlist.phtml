<?php if ($block->getWishlistHelper()->isAllow()) : ?>
    <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('wishlist/index/add')) ?>" class="inline-block">
        <?= $block->getBlockHtml('formkey') ?>
        <input type="hidden" name="product" value="<?= (int) $block->getProduct()->getId() ?>" />
        <button type="submit"
                class="action towishlist"
                title="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                data-action="add-to-wishlist">
            <span class="sr-only"><?= $escaper->escapeHtml(__('Add to Wish List')) ?></span>
        </button>
    </form>
<?php endif; ?>
