 * Product page "Add to Wish List" (icon only): submits the add-to-cart form
 * with formaction, so the chosen `super_attribute[...]` goes along (stock's
 * JS copied it; without it the size/color was lost).
 *
 * @var \Magento\Wishlist\Block\Catalog\Product\View\AddTo\Wishlist $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<?php if ($block->isWishListAllowed()): ?>
    <button type="submit"
            form="product_addtocart_form"
            formaction="<?= $escaper->escapeUrl($block->getUrl('wishlist/index/add')) ?>"
            class="action towishlist"
            data-action="add-to-wishlist"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>">
        <span class="sr-only"><?= $escaper->escapeHtml(__('Add to Wish List')) ?></span>
    </button>
<?php endif; ?>
