 *
 * The dropdown is `right-0` at every width (the button sits at the right edge).
 * The fragment replaces this <ul>, so keep its classes in sync with
 * Zero_Core::customer/account-links.phtml.
 *
 * @var \Magento\Customer\Block\Account\Navigation $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Zero\Core\ViewModel\CurrentUrlEncoded $currentUrlViewModel
 */
$currentUrlViewModel = $block->getData('currentUrlViewModel');
?>
