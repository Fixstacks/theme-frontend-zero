 *
 * Order cancellation dialog. Stock has only the GraphQL `cancelOrder`
 * mutation, so this needs JS: a <dialog> and one delegated listener
 * (guarded by window.__zeroCancelOrderInit). Confirm posts the mutation with
 * the reason; errors show in the status region, success reloads.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var $escaper Magento\Framework\Escaper
 */
$order = $block->getOrder();
$orderId = (int) $order->getId();
$dialogId = 'cancel-order-modal-' . $orderId;
$graphqlUrl = $block->getGraphqlUrl();
?>
<dialog id="<?= $escaper->escapeHtmlAttr($dialogId) ?>" class="cancel-order-modal modal"
        data-graphql-url="<?= $escaper->escapeHtmlAttr($graphqlUrl) ?>"
        data-order-id="<?= /* @noEscape */ $orderId ?>">
    <div class="modal-box">
        <h3><?= $escaper->escapeHtml(__('Cancel order')) ?>
            <span class="cancel-order-id"><?= $escaper->escapeHtml($order->getRealOrderId()) ?></span>
        </h3>
        <p><?= $escaper->escapeHtml(__('Provide a cancellation reason:')) ?></p>
        <select class="cancel-order-reason select select-bordered w-full" data-role="reason" name="reason">
            <?php foreach ($block->getReasons() as $key => $description) : ?>
                <option value="<?= $escaper->escapeHtmlAttr(__($description)) ?>">
                    <?= $escaper->escapeHtml(__($description)) ?>
                </option>
            <?php endforeach; ?>
        </select>
        <div class="cancel-order-status" role="status" aria-live="polite" hidden></div>
        <div class="cancel-order-actions mt-4 flex justify-end gap-2">
            <button type="button" data-role="close" class="btn btn-ghost">
                <span><?= $escaper->escapeHtml(__('Close')) ?></span>
            </button>
            <button type="button" data-role="confirm" class="btn btn-primary">
                <span><?= $escaper->escapeHtml(__('Confirm')) ?></span>
            </button>
        </div>
    </div>
</dialog>
<script src="<?= $escaper->escapeUrl($block->getViewFileUrl('js/cancel-order.js')) ?>" defer></script>
