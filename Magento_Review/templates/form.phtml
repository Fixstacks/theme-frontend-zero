                    disabled="disabled"
                <?php endif; ?>>
                <span><?= $escaper->escapeHtml(__('Submit Review')) ?></span>
            </button>
        </div>
    </div>
</form>
<?php else: ?>
    <div class="message info notlogged alert alert-info alert-soft text-sm py-2" id="review-form">
