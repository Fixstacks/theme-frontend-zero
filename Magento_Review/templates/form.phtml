//phpcs:disable Generic.Files.LineLength
?>
<div class="block review-add">
    <div class="block-title"><strong><?= $escaper->escapeHtml(__('Write Your Own Review')) ?></strong></div>
<div class="block-content">
<?php if ($block->getAllowWriteReviewFlag()):?>
<form action="<?= $escaper->escapeUrl($block->getAction()) ?>" class="review-form" method="post" enctype="multipart/form-data" id="review-form" data-bind="scope: 'review-form'">
    <?= $block->getBlockHtml('formkey') ?>
    <?= $block->getChildHtml('form_fields_before') ?>
    <fieldset class="fieldset review-fieldset" data-hasrequired="<?= $escaper->escapeHtmlAttr(__('* Required Fields')) ?>">
        <legend class="legend review-legend"><span><?= $escaper->escapeHtml(__("You're reviewing:")) ?></span><strong class="ms-1.5"><?= $escaper->escapeHtml($block->getProductInfo()->getName()) ?></strong></legend><br />
        <?php if ($block->getRatings() && $block->getRatings()->getSize()): ?>
        <span id="input-message-box"></span>
        <fieldset class="field required review-field-ratings border-0 mb-5 p-0">
            <legend class="label block whitespace-normal text-label font-medium mb-1"><span><?= $escaper->escapeHtml(__('Your Rating')) ?></span></legend><br/>
            <div class="control">
                <div class="nested" id="product-review-table">
                    <?php foreach ($block->getRatings() as $_rating): ?>
                        <?php
                        $optionsInOrder = [];
                        $iterator = 1;
                        foreach ($_rating->getOptions() as $_option) {
                            $optionsInOrder[] = ['option' => $_option, 'iterator' => $iterator];
                            $iterator++;
                        }
                        ?>
                        <div class="field choice review-field-rating">
                            <label class="label mb-0 min-w-20 <?= count($block->getRatings()) === 1 ? 'sr-only' : '' ?>" id="<?= $escaper->escapeHtml($_rating->getRatingCode()) ?>_rating_label"><span><?= $escaper->escapeHtml($_rating->getRatingCode()) ?></span></label>
                            <div class="control review-control-vote flex flex-row-reverse justify-end gap-0.5">
                            <?php foreach (array_reverse($optionsInOrder) as $item): ?>
                                <?php $_option = $item['option'];
                                $iterator = $item['iterator']; ?>
                                <input
                                    type="radio"
                                    name="ratings[<?= $escaper->escapeHtmlAttr($_rating->getId()) ?>]"
                                    id="<?= $escaper->escapeHtmlAttr($_rating->getRatingCode()) ?>_<?= $escaper->escapeHtmlAttr($_option->getValue()) ?>"
                                    value="<?= $escaper->escapeHtmlAttr($_option->getId()) ?>"
                                    class="radio sr-only"
                                    data-validate="{'rating-required':true}"
                                    aria-labelledby="<?= $escaper->escapeHtmlAttr($_rating->getRatingCode()) ?>_rating_label <?= $escaper->escapeHtmlAttr($_rating->getRatingCode()) ?>_<?= $escaper->escapeHtmlAttr($_option->getValue()) ?>_label" />
                                <label
                                    class="rating-<?= $escaper->escapeHtmlAttr($iterator) ?> cursor-pointer text-2xl leading-none text-base-300"
                                    for="<?= $escaper->escapeHtmlAttr($_rating->getRatingCode()) ?>_<?= $escaper->escapeHtmlAttr($_option->getValue()) ?>"
                                    title="<?= $escaper->escapeHtmlAttr(__('%1 %2', $iterator, $iterator > 1 ? __('stars') : __('star'))) ?>"
                                    id="<?= $escaper->escapeHtmlAttr($_rating->getRatingCode()) ?>_<?= $escaper->escapeHtmlAttr($_option->getValue()) ?>_label">
                                    <span class="sr-only"><?= $escaper->escapeHtml(__('%1 %2', $iterator, $iterator > 1 ? __('stars') : __('star'))) ?></span>
                                </label>
                            <?php endforeach; ?>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
                <input type="hidden" name="validate_rating" class="validate-rating" value="" />
            </div>
        </fieldset>
    <?php endif ?>
        <div class="field review-field-nickname required">
            <label for="nickname_field" class="label"><span><?= $escaper->escapeHtml(__('Nickname')) ?></span></label>
            <div class="control">
                <input type="text" name="nickname" id="nickname_field" class="input-text" required maxlength="128" data-validate="{required:true}" data-bind="value: nickname()" />
            </div>
        </div>
        <div class="field review-field-summary required">
            <label for="summary_field" class="label"><span><?= $escaper->escapeHtml(__('Summary')) ?></span></label>
            <div class="control">
